% Compute the gain and the offset of the accelerometer
%
%   [M,w] = accCalib(acc)
%
%   acc: 3 x N matrix containing the acceleration measurements for the
%           calibration
%
%   M:  gain matrix, 3 x 3
%   w:  offset, 3 x 1
%   R:  rotation matrix (normalized matrix), 3 x 3
%   G:  gain matrix (diagonal matrix), 3 x 3
%
function [M,w,R,G] = accCalib(acc)

ax = acc(1,:);
ay = acc(2,:);
az = acc(3,:);

G = eye(3);
R = eye(3);

w = zeros(3,1);

%??????????????????????????????????????????????????????????????????????????
%   Implement the ellipsoid fitting algorthm which finally delivers w, R,
%   and G.

M_meas = [ax.^2,ay.^2,az.^2,ax,ay,az]'; % we eliminate here the terms related to the rotations
d= ones(length(ax),1); 

% Calculate the coeficients that minimize the error:
p = M_meas \d; %p is the vector of the parameters we want to calculate

%Calculate the offset
A_ = diag([p(1),p(2),p(3)]); %in this case is diagonal due to the simplification
b_ = [p(4); p(5); p(6)]; %lineal vector

w = -0.5 * (A_\b_);
%the solution of the least squares states that the ellipsoid is in the
%origin. Nevertheless, it has an offset, calculated above (w). To take that
%into account, it is needed to calculate the scale factor (correct the size
%of the matrix)
scale_factor = 1+w' *A_*w;
A_corrected = A_ /scale_factor;



%   M is the model matrix and describes the transformation of the
%   uncalibrated acceleration measurement to the unit sphere. The
%   cooridnate system of the elliposid is not necessarily aligned to the
%   coordinate system of the accelerometer, i.e. R is usually not an
%   identiy matrix. R can later be used to transform the calibrated
%   measurements back to the coordinate system of the accelerometer.


%??????????????????????????????????????????????????????????????????????????

M = G*R;

end