close all
clear all

% Load transformations need by this script, fallback to identity if not
% found.
vars = {'T_acc_0'};

for k=1:length(vars)
    if ~isfile([vars{k} '.mat'])
        eval([vars{k} ' = eye(4);']);
        continue;
    end
    load(vars{k});
end


regexFile = '*/data/*acc*.mat';

files = dir(regexFile);

% Use this point to check if the orientation is correct.
refPointInd = 11436;

acc_raw = [];

for k=1:length(files)
    file = files(k);
    name = file.name;
    path = file.folder;
    fileNamePath = [path '/' name];
    
    disp(['Load experiment: ' name]);
    
    temp = load(fileNamePath);
    expt(k) = temp.expt;
    
    acc_raw = [acc_raw, expt(k).imu.acc];
end

% Use all the measurements and compute the model matrix and the offset.
[M,w,R,G] = accCalib(acc_raw);

disp('Offset:');
disp('w =');
disp(w);

disp('Model matrix:');
disp('M =');
disp(M);


disp('Rotation matrix:');
disp('R =');
disp(R);

disp('Gain matrix:');
disp('G =');
disp(G);


T_e_0 = eye(4);

%??????????????????????????????????????????????????????????????????????????
%   The tranformation T_e_0 matrix to represent the coordinate system of 
%   the ellipsoid wrt to the base frame 0. 
%
%   Use R and w of the calibration to compose this transfomration matrix.

T_e_0(1:3,1:3) = R;
T_e_0(1:3,4) = w;

%??????????????????????????????????????????????????????????????????????????


disp('Ellipsoid wrt. base frame:');
disp('T_e_0 =');
disp(T_e_0);



%??????????????????????????????????????????????????????????????????????????
%   Compute the homogeneous model matrix 
%   - Make sure that Tm does not rotate the coordinate axes
%   - Tm should approximately be a diagonal matrix
%   - Use G and R to compose this matrix

Tm = eye(4);
Tm(1:3,1:3) = G;

%??????????????????????????????????????????????????????????????????????????

disp('Homogeneous model matrix:');
disp('Tm =');
disp(Tm);

%??????????????????????????????????????????????????????????????????????????
%   Compute the homogeneous offset matrix
%   - Use w to compose this matrix
%   
%
Tw = eye(4);
Tw(1:3,4) = -w;

%??????????????????????????????????????????????????????????????????????????

disp('Homogeneous offset matrix:');
disp('Tw =');
disp(Tw);


%??????????????????????????????????????????????????????????????????????????
%   Compute the homogeneous calibration matrix
%   - first remove the offset from the measurements
%   - then compensate the gains of the measurements

T_raw_acc = Tm*Tw;

%??????????????????????????????????????????????????????????????????????????


%??????????????????????????????????????????????????????????????????????????
%   Compute the calibrated measurements using T_raw_acc
%   - Extend acc_raw to homogeneous coordinates such that 
%        isequal(size(acc_raw),[4 N]) == true
%   - Transform acc_raw to acc_calib using T_raw_acc
%
%   NOTE: The error of the calibrated acc will be at least an order of
%   magnitude less than the uncalibrated acc.
acc_h=[acc_raw; ones(1,size(acc_raw,2))];
acc_calib_h=T_raw_acc*acc_h;
acc_calib = acc_calib_h(1:3,:);

%??????????????????????????????????????????????????????????????????????????


% Error of uncalibrated acc
n = vecnorm(acc_raw(1:3,:));
err = sum(n)/length(n)-1;

disp('Error of uncalibrated acc:');
disp(['err = ' num2str(err)]);
fprintf('\n');



% Error of calibration
n = vecnorm(acc_calib(1:3,:));
err = sum(n)/length(n)-1;

disp('Error of calibration:');
disp(['err = ' num2str(err)]);
fprintf('\n');




%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% points to plot
p = acc_raw;

figure
hold on
grid on
daspect([1 1 1]);
view([31,35]);

drawCoordinateSystem3D(eye(4),0.5);

x = p(1,:);
y = p(2,:);
z = p(3,:);

plot3(x,y,z,'b.');

drawCoordinateSystem3D(T_e_0,0.2);

plotSphere(1);

x = p(1,refPointInd);
y = p(2,refPointInd);
z = p(3,refPointInd);
h = plot3(x,y,z,'b');
set(h,'LineStyle','none');
set(h,'MarkerSize',30);
set(h,'Marker','.');
set(h,'Color','r');

title('Raw measurements')



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% points to plot
p = acc_calib;

figure
hold on
grid on
daspect([1 1 1]);
view([31,35]);

drawCoordinateSystem3D(eye(4),0.5);

x = p(1,:);
y = p(2,:);
z = p(3,:);
plot3(x,y,z,'b.');

plotSphere(1);


x = p(1,refPointInd);
y = p(2,refPointInd);
z = p(3,refPointInd);
h = plot3(x,y,z,'b');
set(h,'LineStyle','none');
set(h,'MarkerSize',30);
set(h,'Marker','.');
set(h,'Color','r');

title('Calibrated measurements')



%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Check the measurements

disp('Transform acc coordinate system to coordinate system 0:');
disp('T_acc_0 =')
disp(T_acc_0);


% Load imu data with defined poses
regexFile = 'data/acc*.mat';
files = dir(regexFile);

acc_mean = [];

for k=1:length(files)
    file = files(k);
    name = file.name;
    path = file.folder;
    fileNamePath = [path '/' name];
    
    disp(['Load experiment: ' name]);
    
    temp = load(fileNamePath);
    expt(k) = temp.expt;

    acc_raw(k).name = expt(k).name;
    acc_raw(k).mean = mean(expt(k).imu.acc,2);

end

name2el = @(s,name) s(strcmp({s(:).name},name));

names = {'accXp','accXn','accYp','accYn','accZp','accZn'};
descr = {'+x','-x','+y','-y','+z','-z'};

for k=1:length(names)
    el = name2el(acc_raw,names{k});
    
    acc_raw_mean = el.mean;
    
    %??????????????????????????????????????????????????????????????????????
    %   Use T_acc_0 and T_raw_acc to calibrate the measurements and
    %   transform them to the base coordinate frame 0.

    % Expand acc_raw to homogeneous coordinates such that 
    %   isequal(size(acc_raw),[4 1]) == true
    acc_h=[acc_raw_mean;1];
    % Transform acc_raw_mean to a_0
    a_0_h=T_acc_0*T_raw_acc*acc_h;
    a_0=a_0_h;
    
    %??????????????????????????????????????????????????????????????????????
    
    str = ['Calibrated gravitational acceleration in ' descr{k} ':'];
    disp(str)
    disp(a_0)
end


save('T_raw_acc.mat','T_raw_acc');
